NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://web2database:<MAT_KHAU_MOI>@webadvance.p2w8ww5.mongodb.net/caraveso?retryWrites=true&w=majority&appName=webadvance
JWT_SECRET=
COOKIE_SECRET=
# Bắt buộc nếu gửi email OTP thật (Brevo, API v3). Lấy key tại Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
# Firebase Admin (đăng nhập Google): lấy ở Project settings → Service accounts → Generate new private key.
# Có thể dùng GOOGLE_APPLICATION_CREDENTIALS trỏ tới file JSON thay cho 3 biến dưới.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
BANK_WEBHOOK_SECRET=
# SePay (webhook tiền về thật): API Key đặt ở bước Bảo mật khi tạo webhook trên SePay.
SEPAY_API_KEY=
# Tài khoản nhận tiền QR, có giá trị thì ghi đè cấu hình payment.bankAccount trong DB.
# BANK_ID là mã ngân hàng VietQR (MB, VCB, TCB, ACB...).
BANK_ID=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
# Sender phải là địa chỉ đã xác thực (Senders & IP / Domains) trong tài khoản Brevo.
OTP_EMAIL_FROM=CaraVeso <no-reply@your-verified-domain.com>
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
# Trang quản trị, dùng tạo liên kết đặt mật khẩu gửi cho Admin mới (AD-11)
ADMIN_WEB_URL=http://localhost:4201
EMBEDDING_URL=
EMBEDDING_MODEL=clip
VECTOR_SEARCH_INDEX=product_image_vector
# Supabase Storage (lưu ảnh). SERVICE_ROLE_KEY chỉ dùng trên server, không commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Tên bucket công khai (mặc định images)
SUPABASE_STORAGE_BUCKET=images

# Chat AI: GEMINI_API_KEY chỉ dùng ở backend; API chat sẽ báo chưa cấu hình nếu để trống.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_FALLBACK_MODEL=gemini-flash-lite-latest
CHAT_AI_TIMEOUT_MS=45000
CHAT_AI_RATE_LIMIT=20
CHAT_AI_RATE_WINDOW_SECONDS=60
CHAT_HISTORY_LIMIT=20

# Service ML chấm điểm khách (repo DATATHON-ML: src/api.py). ML_API_TOKEN phải trùng ở cả hai bên.
ML_API_URL=http://127.0.0.1:8000
ML_API_TOKEN=<chuoi-ngau-nhien>
