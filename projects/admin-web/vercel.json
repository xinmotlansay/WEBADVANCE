{
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npx ng build admin-web --base-href / && rm -rf projects/admin-web/out && cp -R dist/admin-web/browser projects/admin-web/out",
  "outputDirectory": "out",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://webadvance-vwwp.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://webadvance-vwwp.onrender.com/uploads/$1" },
    { "source": "/socket.io/(.*)", "destination": "https://webadvance-vwwp.onrender.com/socket.io/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
